"""The connector contract (docs/reference/connector-contract.md), checked by the conformance kit."""

from datetime import date

import pytest

from meterline.conformance import RULES, Connector, check
from @@PKG@@ import complete_through, run
from @@PKG@@.normalise import is_final
from @@PKG@@.testing import FakeAPI

OPTIONS = {"provider_account_id": "org-one"}


def _duplicate(fake):
    """One answer holds a row twice: the first row of the first day is served again (R16)."""
    day = sorted(fake.days)[0]
    fake.days[day].append(dict(fake.days[day][0]))


CONNECTOR = Connector(
    name="@@DIST@@",
    run=run,
    make_fake=FakeAPI,
    credentials=lambda fake: {"@@ENV@@": fake.api_key},
    backfill_options={"since": date(2026, 9, 1), **OPTIONS},
    daily_options=OPTIONS,
    # "" matches every path, so the kit's faults hit every endpoint and R10-R12 cover all of them
    fail=lambda fake, status, times: fake.fail("", status, times=times),
    bad_options={"rate_per_minute": 0},
    duplicate=_duplicate,
    complete_through=complete_through,
    is_final=is_final,
)


@pytest.mark.parametrize("rule", RULES, ids=lambda rule: rule.id)
def test_the_connector_keeps_the_contract(rule, tmp_path):
    check(rule, CONNECTOR, tmp_path)


def test_the_run_manifest_round_trips_requested(tmp_path):
    """``requested`` ("auto" when auto chose the command) is written and read back; an older manifest without it reads as None."""
    import json
    from datetime import datetime, timezone

    from meterline.run import requested

    from @@PKG@@.fetch import RunManifest

    pulled_at = datetime(2026, 9, 15, 6, 0, tzinfo=timezone.utc)
    with requested("auto"):
        made = RunManifest("backfill", "20260915T060000Z", pulled_at, "org-one")
    path = made.write(tmp_path)
    assert RunManifest.read(path).requested == "auto" and RunManifest.read(path) == made
    old = json.loads(path.read_text(encoding="utf-8"))
    del old["requested"]
    path.write_text(json.dumps(old), encoding="utf-8")
    assert RunManifest.read(path).requested is None
