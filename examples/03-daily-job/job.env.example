# The environment file of meterline-job.service: one NAME= line per variable a connector or gold reads, with no value here.
# Copy it to /etc/meterline/job.env, fill in the values you need, and make it readable by the service's user only:
#     install -m 0600 -o meterline job.env.example /etc/meterline/job.env
# Never commit the filled-in file. A connector you do not run needs none of its lines.
#
# meterline-anthropic (Enterprise Analytics API key)
ANTHROPIC_ANALYTICS_KEY=
# meterline-anthropic-admin (Admin API key)
ANTHROPIC_ADMIN_KEY=
# meterline-litellm (the proxy's admin key and its address)
LITELLM_API_KEY=
LITELLM_BASE_URL=
# meterline-copilot (usage token; the billing token defaults to the usage token: delete the COPILOT_BILLING_TOKEN line to use that default, since an empty value is a value)
COPILOT_TOKEN=
COPILOT_BILLING_TOKEN=
# meterline-gold (the hashing key, at least 32 bytes; keep it, a lost key breaks the link between builds)
METERLINE_GOLD_KEY=
