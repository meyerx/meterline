{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Which files of a gold folder may be served to which reader (meterline_gold.servable reads it). The source is meterline_gold/audiences.json; this schema is generated by meterline_gold.contract; do not edit by hand.",
  "properties": {
    "description": {
      "type": "string"
    },
    "gold_schema_version": {
      "const": "2.1"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "audience": {
            "enum": [
              "central",
              "exec",
              "manager",
              "person",
              "none"
            ]
          },
          "contains_person_keys": {
            "type": "boolean"
          },
          "hidden_marker": {
            "anyOf": [
              {
                "const": "hidden"
              },
              {
                "type": "null"
              }
            ]
          },
          "pattern": {
            "minLength": 1,
            "type": "string"
          },
          "serve": {
            "enum": [
              "audience-only",
              "central-only",
              "never"
            ]
          }
        },
        "required": [
          "audience",
          "contains_person_keys",
          "hidden_marker",
          "pattern",
          "serve"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "description",
    "gold_schema_version",
    "rules"
  ],
  "title": "gold-audiences.json",
  "type": "object"
}
