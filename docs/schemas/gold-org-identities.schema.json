{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One data row of identities.csv, read as an object of column name to cell text; an empty cell is null. The header row must be exactly the columns of x-columns, in that order. Generated from meterline_gold/load.py by meterline_gold.contract; do not edit by hand. Meaning of each column: the gold spec, section 3.2.",
  "else": {
    "properties": {
      "person_id": {
        "minLength": 1,
        "type": "string"
      }
    }
  },
  "if": {
    "properties": {
      "method": {
        "const": "non_person"
      }
    }
  },
  "properties": {
    "actor_email": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_id": {
      "minLength": 1,
      "type": "string"
    },
    "actor_kind": {
      "minLength": 1,
      "type": "string"
    },
    "actor_login": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "enum": [
        "email",
        "manual",
        "scim",
        "derived",
        "oidc_claim",
        "non_person"
      ]
    },
    "person_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "valid_from": {
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "person_id",
    "provider",
    "method",
    "actor_kind",
    "actor_id",
    "actor_login",
    "actor_email",
    "valid_from",
    "valid_to"
  ],
  "then": {
    "properties": {
      "person_id": {
        "type": "null"
      }
    }
  },
  "title": "identities.csv",
  "type": "object",
  "x-columns": [
    "person_id",
    "provider",
    "method",
    "actor_kind",
    "actor_id",
    "actor_login",
    "actor_email",
    "valid_from",
    "valid_to"
  ]
}
