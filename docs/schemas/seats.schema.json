{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One line of records/seats/<batch_id>.jsonl, record_version 2. Generated from meterline/records.py by meterline.schema; do not edit by hand. Fields: docs/records.md. Retired names: before the first public release the field org_id was renamed provider_account_id (record_version 2 was redefined, not bumped).",
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "daily_active": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_refreshed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "grain": {
      "const": "day"
    },
    "monthly_active": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_cancellations": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_invites": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "period_end": {
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "period_start": {
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "provider_account_id": {
      "minLength": 1,
      "type": "string"
    },
    "pulled_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$",
      "type": "string"
    },
    "record_version": {
      "const": 2
    },
    "scope": {
      "type": "string"
    },
    "seats": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "weekly_active": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "batch_id",
    "grain",
    "period_end",
    "period_start",
    "provider",
    "provider_account_id",
    "pulled_at",
    "record_version",
    "scope"
  ],
  "title": "SeatSnapshot",
  "type": "object",
  "x-record-key": [
    "provider",
    "provider_account_id",
    "scope",
    "period_start"
  ]
}
