{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One data row of central/scenario_summary.csv, read as an object of column name to cell text; an empty cell is null. The header row must be exactly the columns of x-columns, in that order. Generated from meterline_gold/write.py and meterline_gold/dataset_docs.py by meterline_gold.contract; do not edit by hand. Meaning of each column: docs/reference/gold-datasets.md and the gold spec, sections 6 to 8.",
  "properties": {
    "month": {
      "description": "Calendar month, YYYY-MM.",
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": [
        "string"
      ],
      "x-gold-type": "text",
      "x-hidden-covered": false,
      "x-unit": "month"
    },
    "persons": {
      "description": "Number of persons with a cap in the scenario.",
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": [
        "string"
      ],
      "x-gold-type": "count",
      "x-hidden-covered": false,
      "x-unit": "count"
    },
    "persons_excess": {
      "description": "Sum of the persons' excess.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "persons_stopped": {
      "description": "Persons whose position passed their cap.",
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": [
        "string"
      ],
      "x-gold-type": "count",
      "x-hidden-covered": false,
      "x-unit": "count"
    },
    "persons_top_up_total": {
      "description": "Sum of the persons' top_up_total.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "scenario_id": {
      "description": "Id of the shadow scenario from the policy.",
      "type": [
        "string"
      ],
      "x-gold-type": "text",
      "x-hidden-covered": false,
      "x-unit": "key"
    },
    "schema_version": {
      "description": "GOLD_SCHEMA_VERSION of the build that wrote the file; the same on every row.",
      "enum": [
        "2.0"
      ],
      "type": [
        "string"
      ],
      "x-gold-type": "text",
      "x-hidden-covered": false,
      "x-unit": "text"
    },
    "units": {
      "description": "Number of units with an envelope in the scenario.",
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": [
        "string"
      ],
      "x-gold-type": "count",
      "x-hidden-covered": false,
      "x-unit": "count"
    },
    "units_excess": {
      "description": "Sum of the units' excess.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "units_stopped": {
      "description": "Units whose position passed their envelope.",
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": [
        "string"
      ],
      "x-gold-type": "count",
      "x-hidden-covered": false,
      "x-unit": "count"
    },
    "units_top_up_total": {
      "description": "Sum of the units' top_up_total.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "month",
    "persons",
    "persons_stopped",
    "persons_excess",
    "persons_top_up_total",
    "units",
    "units_stopped",
    "units_excess",
    "units_top_up_total"
  ],
  "title": "gold-dataset-scenario_summary",
  "type": "object",
  "x-audiences": [
    "central"
  ],
  "x-columns": [
    "schema_version",
    "scenario_id",
    "month",
    "persons",
    "persons_stopped",
    "persons_excess",
    "persons_top_up_total",
    "units",
    "units_stopped",
    "units_excess",
    "units_top_up_total"
  ],
  "x-cost-column-rule": "The `*_excess` and `*_top_up_total` columns are what the scenario would have done; they are never spend.",
  "x-dataset": "scenario_summary",
  "x-files": [
    "central/scenario_summary.csv"
  ],
  "x-grain": "One row per scenario and month.",
  "x-joins": {
    "scenario_id": [
      "scenario_persons.scenario_id"
    ]
  },
  "x-primary-key": [
    "scenario_id",
    "month"
  ]
}
