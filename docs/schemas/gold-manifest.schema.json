{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The manifest of a gold folder, gold_schema_version 2.0. A key is added or changed only with a new GOLD_SCHEMA_VERSION. Generated from meterline_gold/write.py by meterline_gold.contract; do not edit by hand. Meaning of each key: the gold spec, section 9.3.",
  "properties": {
    "as_of": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "data_through": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "meterline-gold"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "gold_schema_version": {
      "const": "2.0"
    },
    "input_flags": {
      "additionalProperties": false,
      "properties": {
        "persons_missing": {
          "minimum": 0,
          "type": "integer"
        },
        "rows_person_missing": {
          "minimum": 0,
          "type": "integer"
        },
        "units_parent_unknown": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "persons_missing",
        "rows_person_missing",
        "units_parent_unknown"
      ],
      "type": "object"
    },
    "inputs": {
      "additionalProperties": false,
      "properties": {
        "invoice_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "org": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "prices_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "silver": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "invoice_sha256",
        "org",
        "policy_sha256",
        "prices_sha256",
        "silver"
      ],
      "type": "object"
    },
    "key_check": {
      "pattern": "^kc_",
      "type": "string"
    },
    "months": {
      "items": {
        "pattern": "^[0-9]{4}-[0-9]{2}$",
        "type": "string"
      },
      "type": "array"
    },
    "outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "path": {
            "type": "string"
          },
          "rows": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "bytes",
          "path",
          "rows",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "suppression": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "minimum": 0,
          "type": "integer"
        },
        "differencing": {
          "minimum": 0,
          "type": "integer"
        },
        "k": {
          "minimum": 0,
          "type": "integer"
        },
        "secondary": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cells",
        "differencing",
        "k",
        "secondary"
      ],
      "type": "object"
    },
    "unknown_envelope_keys": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    }
  },
  "required": [
    "as_of",
    "data_through",
    "generator",
    "gold_schema_version",
    "input_flags",
    "inputs",
    "key_check",
    "months",
    "outputs",
    "suppression",
    "unknown_envelope_keys"
  ],
  "title": "manifest.json",
  "type": "object"
}
