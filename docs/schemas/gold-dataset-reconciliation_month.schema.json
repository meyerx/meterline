{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One data row of central/reconciliation_month.csv, read as an object of column name to cell text; an empty cell is null. The header row must be exactly the columns of x-columns, in that order. Generated from meterline_gold/write.py and meterline_gold/dataset_docs.py by meterline_gold.contract; do not edit by hand. Meaning of each column: docs/reference/gold-datasets.md and the gold spec, sections 6 to 8. Retired names: schema_version 2.0 renamed a column (org_id is now provider_account_id).",
  "properties": {
    "actor_cost_source": {
      "description": "Sum of cost_source allocated to actors.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "actor_credits": {
      "description": "Credits allocated to actors.",
      "pattern": "^-?(0|[0-9]+(\\.[0-9]+)?)$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "quantity",
      "x-hidden-covered": false,
      "x-unit": "count"
    },
    "cost_ref": {
      "description": "Reference cost: usage priced from the price list you supplied, in the reference currency.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "currency": {
      "description": "ISO 4217 reference currency of the row.",
      "type": [
        "string"
      ],
      "x-gold-type": "text",
      "x-hidden-covered": false,
      "x-unit": "text"
    },
    "invoice_seats": {
      "description": "Invoiced seat amount from the invoice file, if one was given.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "invoice_seats_gap": {
      "description": "invoice_seats minus seat_cost.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "invoice_usage": {
      "description": "Invoiced usage amount from the invoice file, if one was given.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "invoice_usage_gap": {
      "description": "invoice_usage minus org_cost_source.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "month": {
      "description": "Calendar month, YYYY-MM.",
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": [
        "string"
      ],
      "x-gold-type": "text",
      "x-hidden-covered": false,
      "x-unit": "month"
    },
    "org_cost_basis": {
      "description": "cost_basis of the organisation totals; mixed if they differ.",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "text",
      "x-hidden-covered": false,
      "x-unit": "text"
    },
    "org_cost_source": {
      "description": "Organisation-wide cost the provider reports (OrgTotal records).",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "org_credits": {
      "description": "Organisation-wide credits the provider reports.",
      "pattern": "^-?(0|[0-9]+(\\.[0-9]+)?)$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "quantity",
      "x-hidden-covered": false,
      "x-unit": "count"
    },
    "provider": {
      "description": "Provider the usage or seats came from, as the silver records name it.",
      "type": [
        "string"
      ],
      "x-gold-type": "text",
      "x-hidden-covered": false,
      "x-unit": "text"
    },
    "provider_account_id": {
      "description": "Provider account label from the silver records; empty only where seats are matched on provider alone.",
      "type": [
        "string"
      ],
      "x-gold-type": "text",
      "x-hidden-covered": false,
      "x-unit": "key"
    },
    "ref_vs_source_gap": {
      "description": "cost_ref minus actor_cost_source; may be negative.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "ref_vs_source_share": {
      "description": "Absolute ref_vs_source_gap divided by actor_cost_source.",
      "pattern": "^-?[0-9]+\\.[0-9]{4}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "ratio",
      "x-hidden-covered": false,
      "x-unit": "ratio"
    },
    "schema_version": {
      "description": "GOLD_SCHEMA_VERSION of the build that wrote the file; the same on every row.",
      "enum": [
        "2.0"
      ],
      "type": [
        "string"
      ],
      "x-gold-type": "text",
      "x-hidden-covered": false,
      "x-unit": "text"
    },
    "unallocated_cost_source": {
      "description": "org_cost_source minus actor_cost_source; empty when the bases differ.",
      "pattern": "^-?[0-9]+\\.[0-9]{2,}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "money",
      "x-hidden-covered": false,
      "x-unit": "currency"
    },
    "unallocated_credits": {
      "description": "org_credits minus actor_credits.",
      "pattern": "^-?(0|[0-9]+(\\.[0-9]+)?)$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "quantity",
      "x-hidden-covered": false,
      "x-unit": "count"
    },
    "unreconciled_share": {
      "description": "unallocated_cost_source divided by org_cost_source: the organisation remainder only. It is not the reference unallocated share (the cookbook KPI one_unallocated_share), which also counts the cost of non-person and unresolved actors.",
      "pattern": "^-?[0-9]+\\.[0-9]{4}$",
      "type": [
        "string",
        "null"
      ],
      "x-gold-type": "ratio",
      "x-hidden-covered": false,
      "x-unit": "ratio"
    }
  },
  "required": [
    "schema_version",
    "month",
    "provider",
    "provider_account_id",
    "currency",
    "actor_cost_source",
    "org_cost_source",
    "org_cost_basis",
    "unallocated_cost_source",
    "unreconciled_share",
    "actor_credits",
    "org_credits",
    "unallocated_credits",
    "cost_ref",
    "ref_vs_source_gap",
    "ref_vs_source_share",
    "invoice_usage",
    "invoice_usage_gap",
    "invoice_seats",
    "invoice_seats_gap"
  ],
  "title": "gold-dataset-reconciliation_month",
  "type": "object",
  "x-audiences": [
    "central"
  ],
  "x-columns": [
    "schema_version",
    "month",
    "provider",
    "provider_account_id",
    "currency",
    "actor_cost_source",
    "org_cost_source",
    "org_cost_basis",
    "unallocated_cost_source",
    "unreconciled_share",
    "actor_credits",
    "org_credits",
    "unallocated_credits",
    "cost_ref",
    "ref_vs_source_gap",
    "ref_vs_source_share",
    "invoice_usage",
    "invoice_usage_gap",
    "invoice_seats",
    "invoice_seats_gap"
  ],
  "x-cost-column-rule": "`org_cost_source` is the provider's organisation-wide total and `actor_cost_source` the part allocated to actors; compare them, do not add them. `cost_ref` is a different basis from both.",
  "x-dataset": "reconciliation_month",
  "x-files": [
    "central/reconciliation_month.csv"
  ],
  "x-grain": "One row per month, provider and provider account.",
  "x-joins": {
    "month": [
      "costs_month.month"
    ],
    "provider": [
      "costs_month.provider"
    ],
    "provider_account_id": [
      "costs_month.provider_account_id"
    ]
  },
  "x-primary-key": [
    "month",
    "provider",
    "provider_account_id"
  ]
}
