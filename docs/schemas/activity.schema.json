{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One line of records/activity/<batch_id>.jsonl, record_version 2. Generated from meterline/records.py by meterline.schema; do not edit by hand. Fields: docs/records.md. Retired names: before the first public release the field org_id was renamed provider_account_id (record_version 2 was redefined, not bumped).",
  "properties": {
    "actor_email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_id": {
      "minLength": 1,
      "type": "string"
    },
    "actor_kind": {
      "enum": [
        "user",
        "proxy_user",
        "end_user",
        "service_account",
        "api_key",
        "unassigned"
      ]
    },
    "actor_login": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "batch_id": {
      "type": "string"
    },
    "commits": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "counters": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "type": "object"
    },
    "data_refreshed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "edits_accepted": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "edits_rejected": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "grain": {
      "enum": [
        "day",
        "month",
        "window"
      ]
    },
    "lines_added": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "lines_removed": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "messages": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "period_end": {
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "period_start": {
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "provider_account_id": {
      "minLength": 1,
      "type": "string"
    },
    "pull_requests": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "pulled_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\+00:00$",
      "type": "string"
    },
    "record_version": {
      "const": 2
    },
    "requests": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "string"
    },
    "sessions": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "suggestions_accepted": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "suggestions_shown": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "actor_id",
    "actor_kind",
    "batch_id",
    "counters",
    "grain",
    "period_end",
    "period_start",
    "product",
    "provider",
    "provider_account_id",
    "pulled_at",
    "record_version",
    "scope"
  ],
  "title": "ActivityRecord",
  "type": "object",
  "x-record-key": [
    "provider",
    "provider_account_id",
    "scope",
    "grain",
    "period_start",
    "actor_kind",
    "actor_id",
    "product"
  ]
}
