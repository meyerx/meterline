{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One data row of memberships.csv, read as an object of column name to cell text; an empty cell is null. The header row must be exactly the columns of x-columns, in that order. Generated from meterline_gold/load.py by meterline_gold.contract; do not edit by hand. Meaning of each column: the gold spec, section 3.2.",
  "properties": {
    "dimension": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "person_id": {
      "minLength": 1,
      "type": "string"
    },
    "role": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit_id": {
      "minLength": 1,
      "type": "string"
    },
    "valid_from": {
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "person_id",
    "unit_id",
    "dimension",
    "role",
    "valid_from",
    "valid_to"
  ],
  "title": "memberships.csv",
  "type": "object",
  "x-columns": [
    "person_id",
    "unit_id",
    "dimension",
    "role",
    "valid_from",
    "valid_to"
  ]
}
